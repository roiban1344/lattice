---
// 頁の枠: 本文の列を画面の中央に置き、広い画面では左の余白に目次を貼る（右に同じ幅の空き列を置いて釣り合わせる）。
// 節は sections で一元管理し、見出しと目次を同じ配列から作る。
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
interface Props { title: string; description?: string; sections: { id: string; title: string }[] }
const { title, description, sections } = Astro.props;
---
<Base title={title} description={description}>
  <div class="grid gap-8 lg:grid-cols-[11rem_minmax(0,46rem)_11rem] lg:justify-center lg:gap-12">
    <Toc items={sections} />
    <article class="grid gap-14"><slot /></article>
  </div>
</Base>
