---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { LANGS, LANG_NAME, SITE_NAME, UI, href, type Lang } from '../i18n';

interface Props { title: string; description?: string; lang: Lang; slug?: string }
const { title, description, lang, slug = '' } = Astro.props;
const other = LANGS.filter((l) => l !== lang);
const abs = (l: Lang) => new URL(href(l, slug), Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    <link rel="alternate" hreflang="x-default" href={abs('en')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="border-b border-rule">
      <div class="mx-auto flex max-w-[78rem] flex-wrap items-baseline gap-x-6 gap-y-1 px-4 py-3 text-[.875rem]">
        <a href={href(lang)} class="font-display text-base font-bold text-ink no-underline">{SITE_NAME[lang]}</a>
        <span class="ml-auto flex gap-4">
          {other.map((l) => <a href={href(l, slug)} hreflang={l} lang={l} class="text-muted no-underline hover:text-accent">{LANG_NAME[l]}</a>)}
          <a href="https://github.com/roiban1344/lattice" class="text-muted no-underline hover:text-accent">GitHub</a>
        </span>
      </div>
    </header>
    <main class="mx-auto max-w-[78rem] px-4 pb-24 pt-10">
      <slot />
    </main>
    <footer class="mx-auto max-w-prose px-4 pb-10 note">{UI.footer[lang]}</footer>
  </body>
</html>
