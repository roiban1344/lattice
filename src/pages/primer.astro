---
import Page from '../layouts/Page.astro';
import { Content, getHeadings } from '../sections/hub/primer.md';
import { tex } from '../lib/tex';
const sections = getHeadings().filter((h) => h.depth === 2).map((h) => ({ id: h.slug, title: h.text }));
const lead = tex(String.raw`各頁の論証で使う言葉を、格子とは何かから順に並べた。どの頁から読み始めても、分からない言葉はここに戻れば追えるようにしている。`);
---
<Page title="前提 — 格子とは何か" description="格子、Gram 行列、偶ユニモジュラー、極値格子、テータ級数、軌道、エルミートテンソル積。" sections={sections}>
  <header class="grid max-w-prose gap-4">
    <h1 class="text-[2.25rem] font-bold">前提</h1>
    <p class="text-[1.1875rem] leading-[1.9]" set:html={lead} />
  </header>
  <div class="prose-lat"><Content /></div>
</Page>
