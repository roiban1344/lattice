---
import Page from '../../layouts/Page.astro';
import Sec from '../../components/Sec.astro';
import Heatmap from '../../components/Heatmap.astro';
import BoundChart from '../../components/BoundChart.astro';
import Funnel from '../../components/Funnel.astro';
import Refs from '../../components/Refs.astro';
import { Content as Claim } from '../../sections/r88/claim.md';
import { Content as Matrices } from '../../sections/r88/matrices.md';
import { Content as Construction } from '../../sections/r88/construction.md';
import { Content as Coul } from '../../sections/r88/coulangeon.md';
import { Content as Rank4 } from '../../sections/r88/rank4.md';
import { Content as Second } from '../../sections/r88/second.md';
import { Content as Props_ } from '../../sections/r88/properties.md';
import { Content as Compare } from '../../sections/r88/compare.md';
import { Content as Ours } from '../../sections/r88/ours.md';
import { basicChecks, coulangeon, sak, SAK_REPO, SAK_SHA } from '../../lib/r88';
import { extremalTheta } from '../../lib/lattice';
import { tex } from '../../lib/tex';
import { n$ } from '../../lib/num';

const sections = [
  { id: 'claim', title: '何を確かめるか' },
  { id: 'matrices', title: '行列を眺める' },
  { id: 'construction', title: '構成: $E\\otimes J$' },
  { id: 'coulangeon', title: 'テンソル階数で分ける' },
  { id: 'rank4', title: '階数 $4$ の場合を列挙で閉じる' },
  { id: 'second', title: '$2$ つ目の格子 $L_0$' },
  { id: 'properties', title: '最小ベクトルの性質' },
  { id: 'compare', title: '$3$ つのテンソル積を並べる' },
  { id: 'ours', title: 'ここで確かめたこと' },
  { id: 'refs', title: '文献' },
];
const S = Object.fromEntries(sections.map((s) => [s.id, s]));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const checksL = basicChecks('L'), checksL0 = basicChecks('L0');
const th88 = extremalTheta(88, 6);
const frac = ([p, q]: readonly [number, number]) => (q === 1 ? `${p}` : `${p}/${q}`);
const t = {
  lead: tex(String.raw`坂本が 2026 年に構成した $88$ 次元の極値偶ユニモジュラー格子を、証明の筋道に沿って読み直している。既に示された極値格子に私たちの物差しを当てて確かめ、証明の型を $112$ 次元の候補に持ち込めるかを探るのが目的。`),
  kv: [[String.raw`$88$`, '次元'], [String.raw`$\min=8$`, '極値（定理）'], [n$(th88.coefficients[4]), '最小ベクトルの本数'], [String.raw`$2$`, '非同型な格子の数']].map(([v, l]) => [tex(v), l]),
  head: [String.raw`$s$`, String.raw`$d_s(E)$`, String.raw`$d_s(J)$`, String.raw`下界 $s\,(d_s(E)\,d_s(J))^{1/s}$`, String.raw`整数の評価`].map(tex),
  chartNote: tex(String.raw`白抜きが下界、塗りが整数に切り上げた評価。$d_s$ の値は [Sak26] Prop. 3.6, 4.1, 4.2, 4.4, 4.5 から取り、下界はこの頁の生成時に計算した。`),
  checkNote: tex(String.raw`この頁の生成時に坂本のリポジトリのデータ（コミット <code>${SAK_SHA.slice(0, 7)}</code>、SHA-256 を照合）から整数で計算した。`),
};
const funnel = [
  { label: '対角と非対角の有限性、$E$ の自己同型で揃える', count: 8159 },
  { label: '短いベクトル $2$ 本の部分格子が $J$ に埋め込める', count: 1376 },
  { label: '$E$ の自己同型で同値なものをまとめる', count: 362 },
  { label: '短いベクトル $4$ 本の部分格子が $J$ に埋め込める', count: 1 },
  { label: '残った $1$ 個が $J$ に埋め込める', count: 0 },
];
---
<Page title="L₈₈ — 坂本の 88 次元格子" description="坂本の 88 次元極値格子の証明を、テンソル階数ごとの Coulangeon の評価と有限の列挙に分けて読み直す。" sections={sections}>
  <header class="grid max-w-[52rem] gap-5">
    <p class="note tracking-[.12em]">極値偶ユニモジュラー格子 · 88 次元 · 既知の最高次元</p>
    <h1 class="text-[2.875rem] font-extrabold leading-tight" set:html={tex(String.raw`$L_{88}$`)} />
    <p class="text-[1.1875rem] leading-[1.9]" set:html={t.lead} />
    <p class="flex flex-wrap gap-2"><span class="chip-exact">✓ 既知の定理 [Sak26]</span><span class="chip-hand">プレプリント（2026-09）</span></p>
    <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {t.kv.map(([v, l]) => <div class="grid gap-0.5 border-t-2 border-ink pt-2"><dt class="text-[1.25rem]" set:html={v} /><dd class="note">{l}</dd></div>)}
    </dl>
    <p class="note">論文: <a href="https://arxiv.org/abs/2609.15633">arXiv:2609.15633</a>。コードとデータ: <a href={SAK_REPO}>坂本のリポジトリ</a>。用語は <a href={`${base}primer/`}>前提</a> の頁にまとめた。</p>
  </header>

  <Sec s={S.claim}><div class="prose-lat"><Claim /></div></Sec>

  <Sec s={S.matrices}>
    <div class="prose-lat"><Matrices /></div>
    <div class="grid gap-6 sm:grid-cols-2">
      <Heatmap src="data/r88/G.json" label="G: L の Gram 行列（88×88）" />
      <Heatmap src="data/r88/G0.json" label="L₀ の Gram 行列（88×88）" />
      <Heatmap src="data/r88/M5.json" label="M₅: ζ₅ の作用" />
      <Heatmap src="data/r88/M23.json" label="M₂₃: ζ₂₃ の作用" />
    </div>
    <div class="panel grid max-w-prose gap-2">
      <h3 class="text-[1.1875rem] font-semibold">データから直接読める事実</h3>
      <p class="note" set:html={t.checkNote} />
      <ul class="grid gap-1 text-[.9375rem]">
        {checksL.map((c) => <li class="flex gap-2"><span class={c.ok ? 'text-ok' : 'text-red-600'}>{c.ok ? '✓' : '✗'}</span><span set:html={tex(`$L$: ${c.what}`)} /></li>)}
        {checksL0.map((c) => <li class="flex gap-2"><span class={c.ok ? 'text-ok' : 'text-red-600'}>{c.ok ? '✓' : '✗'}</span><span set:html={tex(`$L_0$: ${c.what}`)} /></li>)}
      </ul>
    </div>
  </Sec>

  <Sec s={S.construction}><div class="prose-lat"><Construction /></div></Sec>

  <Sec s={S.coulangeon}>
    <div class="prose-lat"><Coul /></div>
    <div class="panel grid gap-3">
      <h3 class="text-[1.1875rem] font-semibold">テンソル階数ごとの評価</h3>
      <BoundChart rows={coulangeon} target={4} />
      <p class="note" set:html={t.chartNote} />
    </div>
    <div class="max-w-prose overflow-x-auto rounded-md border border-rule bg-sheet">
      <table class="tbl">
        <thead><tr>{t.head.map((h) => <th class="num" set:html={h} />)}</tr></thead>
        <tbody>{coulangeon.map((r) => <tr class={r.hmin < 4 ? 'bg-warn-bg' : ''}>
          <td class="num" set:html={tex(`$${r.s}$`)} /><td class="num" set:html={tex(`$${frac(r.dE)}$`)} /><td class="num" set:html={tex(`$${r.dJ}$`)} />
          <td class="num" set:html={tex(`$${r.bound.toFixed(3)}$`)} /><td class="num" set:html={tex(`$h\\ge${r.hmin}$`)} />
        </tr>)}</tbody>
      </table>
    </div>
  </Sec>

  <Sec s={S.rank4}>
    <div class="prose-lat"><Rank4 /></div>
    <div class="panel grid gap-3">
      <h3 class="text-[1.1875rem] font-semibold">候補の数の推移（[Sak26] §5.2）</h3>
      <Funnel steps={funnel} />
      <p class="note">棒の長さは個数の対数。各段のコードと証明書は <a href={sak('theorem_code_map.md')}>theorem_code_map.md</a> に対応表がある。</p>
    </div>
  </Sec>

  <Sec s={S.second}><div class="prose-lat"><Second /></div></Sec>
  <Sec s={S.properties}><div class="prose-lat"><Props_ /></div></Sec>
  <Sec s={S.compare}><div class="prose-lat"><Compare /></div></Sec>
  <Sec s={S.ours}><div class="prose-lat"><Ours /></div></Sec>
  <Sec s={S.refs}><Refs keys={['Sak26', 'Sak26code', 'CN13', 'Neb12', 'MOS75']} /></Sec>
</Page>
