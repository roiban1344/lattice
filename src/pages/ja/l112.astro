---
import Page from '../../layouts/Page.astro';
import Sec from '../../components/Sec.astro';
import Heatmap from '../../components/Heatmap.astro';
import SiegelChart from '../../components/SiegelChart.astro';
import Refs from '../../components/Refs.astro';
import { Content as Claim } from '../../sections/l112/claim.md';
import { Content as Matrices } from '../../sections/l112/matrices.md';
import { Content as Group } from '../../sections/l112/group.md';
import { Content as Theta } from '../../sections/l112/theta.md';
import { Content as Budget } from '../../sections/l112/budget.md';
import { Content as Coulangeon } from '../../sections/l112/coulangeon.md';
import { basicChecks, pub, PUB_REPO, PUB_SHA } from '../../lib/l112';
import { bernoulli, extremalTheta, siegelMean } from '../../lib/lattice';
import { tex } from '../../lib/tex';
import { n$, sci } from '../../lib/num';
import { classes } from '../../data/l112';

const sections = [
  { id: 'claim', title: '主張' },
  { id: 'matrices', title: '行列を眺める' },
  { id: 'group', title: String.raw`群 $\mathrm{SL}_2(29)$` },
  { id: 'theta', title: 'テータ級数による本数の予言' },
  { id: 'budget', title: '対称性の予算' },
  { id: 'coulangeon', title: 'Coulangeon の不等式で見ると' },
  { id: 'refs', title: '文献' },
];
const S = Object.fromEntries(sections.map((s) => [s.id, s]));

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const basic = basicChecks();
const th56 = extremalTheta(56, 6), th112 = extremalTheta(112, 8);
const B = bernoulli(82);
const Sg = (n: number) => siegelMean(n, B);
const budget = [
  { name: String.raw`Leech 格子 $\Lambda_{24}$`, n: 24, w: 8315553613086720000, wText: String.raw`$|\mathrm{Co}_0|\approx 8.3\times10^{18}$`, real: '極値（一意）' },
  { name: String.raw`$\Gamma_{72}$`, n: 72, w: 5241600, wText: String.raw`$5\,241\,600$（カタログの部分群）`, real: '極値' },
  { name: String.raw`$96$ 次元に同じ群`, n: 96, w: 24360, wText: String.raw`$24\,360$`, real: '（仮想）' },
  { name: String.raw`$R$、群 $\mathrm{SL}_2(29)$`, n: 112, w: 24360, wText: String.raw`$24\,360$`, real: '主張は極値' },
  { name: String.raw`$R$、既知の自己同型`, n: 112, w: 584640, wText: String.raw`$584\,640$`, real: '主張は極値' },
].map((r) => ({ ...r, S: Sg(r.n), lambda: Sg(r.n) / r.w }));
const expm = (l: number) => (l > 50 ? String.raw`e^{-${Math.round(l)}}` : l < 1e-4 ? String.raw`\approx 1` : Math.exp(-l).toPrecision(2));
const work = (p: string) => `<code class="text-[.75rem]">${p}</code>`;
const t = {
  lead: tex(String.raw`$112$ 次元の偶ユニモジュラー格子 $R$ を構成し、その最小ノルムが $10$ であることを計算で確かめている。正しければ $R$ は極値格子で、これまでの最高次元 $88$ を更新する。この頁では主張を易しい順に分解し、各段がどのデータとどのコードに支えられているかを示す。`),
  kv: [[String.raw`$112$`, '次元'], [String.raw`$\det=1$`, 'ユニモジュラー'], [String.raw`$\min=10$`, '主張（上界と一致）'], [String.raw`$88$`, 'これまでの最高次元']].map(([v, l]) => [tex(v), l]),
  checksNote: tex(String.raw`この頁の生成時に上の行列から整数（BigInt）で計算した。行列式は Bareiss の分数なし消去 <a href="#ref-Bar68">[Bar68]</a> で求め、途中の主小行列式がすべて正なので正定値（Sylvester の判定法）。同じ検査のコードは <a href="${pub('code/verify/v0_inputs.py')}">code/verify/v0_inputs.py</a>。`),
  classHead: ['位数', '類の数', '元の数', String.raw`$L$ での跡`].map(tex),
  budgetHead: ['格子', String.raw`$n$`, String.raw`$S(n)$`, String.raw`群の位数 $w$`, String.raw`$\lambda=S/w$`, String.raw`$e^{-\lambda}$`, '実際'].map(tex),
  autNote: tex(String.raw`$R$ の「既知の自己同型」は $\mathrm{SL}_2(29)$ の対角作用と、階数 $2$ のエルミート格子のユニタリ自己同型 $48$ 個が生成する群（$-1$ を共有）。自己同型群の全体は決めていない。`),
  sl2Note: tex(String.raw`GAP 4 で計算した。群を最小ベクトル $8\,120$ 本への置換作用として作り、<code>IsomorphismGroups</code> で $\mathrm{SL}(2,29)$ との同型も確かめた。スクリプトは ${work('site/r112/sl2-29-classes.g')} <span class="chip-priv">作業用リポジトリ</span>`),
};
---
<Page lang="ja" slug="l112" description="112 次元の極値偶ユニモジュラー格子 L₁₁₂。" sections={sections}>
  <header class="grid max-w-[52rem] gap-5">
    <p class="note">この頁は執筆中です。以下は 2026-10-15 版の文章で、名前や記述が論文と食い違っています。</p>
    <h1 class="text-[2.25rem] font-bold leading-tight" set:html={tex(String.raw`$R_{112}$`)} />
    <p class="text-[1.1875rem] leading-[1.9]" set:html={t.lead} />
    <p class="flex flex-wrap gap-2"><span class="chip-cand">◇ 候補</span><span class="chip-hand">査読なし・専門家の確認なし</span></p>
    <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {t.kv.map(([v, l]) => <div class="grid gap-0.5 border-t-2 border-ink pt-2"><dt class="text-[1.25rem]" set:html={v} /><dd class="note">{l}</dd></div>)}
    </dl>
    <p class="note">データとコードの本体は <a href={PUB_REPO}>公開リポジトリ</a>（コミット <code>{PUB_SHA.slice(0, 7)}</code>）。</p>
  </header>

  <Sec s={S.claim}><div class="prose-lat"><Claim /></div></Sec>

  <Sec s={S.matrices}>
    <div class="prose-lat"><Matrices /></div>
    <div class="grid gap-6 sm:grid-cols-2">
      <Heatmap lang="ja" src="data/l112/G.json" label="G: L の Gram 行列（56×56）" caption="対称で、対角はすべて偶数。" />
      <Heatmap lang="ja" src="data/l112/tau.json" label="τ（56×56）" caption="見た目は乱雑。" />
      <Heatmap lang="ja" src="data/l112/tau2.json" label="τ²" caption="対角に −5 が並ぶだけ。" />
      <Heatmap lang="ja" src="data/l112/g1.json" label="g₁: SL₂(29) の生成元（位数 5）" />
      <Heatmap lang="ja" src="data/l112/Rblock.json" label="R の Gram 行列（ブロックのまま、112×112）" blocks={56} caption="左上 3G、右上 τG、右下 2G。" />
      <Heatmap lang="ja" src="data/l112/R.json" label="R の Gram 行列（公開した LLL 簡約版）" caption="同じ格子の別の基底。構造は見えない。" />
    </div>
    <div class="panel grid max-w-prose gap-2">
      <h3 class="text-[1.1875rem] font-semibold">データから直接読める事実</h3>
      <p class="note" set:html={t.checksNote} />
      <ul class="grid gap-1 text-[.9375rem]">
        {basic.map((c) => <li class="flex gap-2"><span class={c.ok ? 'text-ok' : 'text-red-600'}>{c.ok ? '✓' : '✗'}</span><span set:html={tex(c.what)} /></li>)}
      </ul>
    </div>
  </Sec>

  <Sec s={S.group}>
    <div class="prose-lat"><Group /></div>
    <div class="max-w-prose overflow-x-auto rounded-md border border-rule bg-sheet">
      <table class="tbl">
        <thead><tr>{t.classHead.map((h) => <th class="num" set:html={h} />)}</tr></thead>
        <tbody>
          {classes.rows.map(([o, c, n, tr]) => <tr><td class="num" set:html={tex(n$(o))} /><td class="num" set:html={tex(n$(c))} /><td class="num" set:html={tex(n$(n))} /><td class="num" set:html={tex(`$${tr}$`)} /></tr>)}
          <tr><td>計</td><td class="num" set:html={tex('$33$')} /><td class="num" set:html={tex(n$(24360))} /><td /></tr>
        </tbody>
      </table>
    </div>
    <p class="note max-w-prose" set:html={t.sl2Note} />
  </Sec>

  <Sec s={S.theta}>
    <div class="prose-lat"><Theta /></div>
    <div class="grid max-w-prose gap-4 sm:grid-cols-2">
      {[[56, th56], [112, th112]].map(([n, th]: any) => (
        <div class="overflow-x-auto rounded-md border border-rule bg-sheet">
          <table class="tbl">
            <thead><tr><th colspan="2" set:html={tex(`$${n}$ 次元（最小 $${th.min}$）`)} /></tr><tr><th class="num">ノルム</th><th class="num">本数</th></tr></thead>
            <tbody>{th.coefficients.map((c: bigint, e: number) => <tr class={2 * e === th.min ? 'bg-accent-soft' : ''}><td class="num" set:html={tex(n$(2 * e))} /><td class="num" set:html={tex(e === 0 ? '$1$' : n$(c))} /></tr>)}</tbody>
          </table>
        </div>
      ))}
    </div>
    <p class="note max-w-prose">同じ計算: <a href={pub('code/verify/v2_theta.py')}>code/verify/v2_theta.py</a> <span class="chip-exact">✓ 有理数で厳密</span></p>
  </Sec>

  <Sec s={S.budget}>
    <div class="prose-lat"><Budget /></div>
    <div class="panel grid gap-3">
      <h3 class="text-[1.1875rem] font-semibold" set:html={tex(String.raw`Siegel 平均 $S(n)$（対数目盛）`)} />
      <SiegelChart refs={[{ value: 24360, label: '|SL₂(29)| = 24 360' }]} highlight={112} knownUpTo={88} />
      <p class="note">頁の生成時に有理数から計算した。同じ計算: <a href={pub('code/verify/v2_theta.py')}>code/verify/v2_theta.py</a></p>
    </div>
    <div class="overflow-x-auto rounded-md border border-rule bg-sheet">
      <table class="tbl">
        <thead><tr>{t.budgetHead.map((h, i) => <th class={i > 0 && i < 6 ? 'num' : ''} set:html={h} />)}</tr></thead>
        <tbody>{budget.map((r) => <tr>
          <td set:html={tex(r.name)} /><td class="num" set:html={tex(n$(r.n))} /><td class="num" set:html={tex(`$${sci(r.S)}$`)} />
          <td class="num" set:html={tex(r.wText)} /><td class="num" set:html={tex(`$${sci(r.lambda)}$`)} /><td class="num" set:html={tex(`$${expm(r.lambda)}$`)} /><td>{r.real}</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p class="note max-w-prose" set:html={t.autNote} />
  </Sec>

  <Sec s={S.coulangeon}><div class="prose-lat"><Coulangeon /></div></Sec>

  <Sec s={S.refs}><Refs keys={['Neb98', 'Neb12', 'CN13', 'Sak26', 'MOS75', 'NS', 'SPLAG', 'ATLAS', 'Bar68']} /></Sec>
</Page>
