---
// 枠の 24 点を、12 桁の 0/1 の住所として 24 行 × 12 列で描く。一直線の 3 点（住所の和が 0）があれば、その 3 行と和の行を色付きで示す。
import { tex } from '../lib/tex';
interface Props { points: number[]; lines: number[][]; title: string; note: string }
const { points, lines, title, note } = Astro.props;
const triple = lines[0] ?? [];
const bits = (p: number) => Array.from({ length: 12 }, (_, t) => (p >> (11 - t)) & 1);
const cell = 16, W = 12 * cell + 64, rows = points.length + (triple.length ? 2 : 0), H = rows * cell + 22;
const sumRow = triple.length ? bits(triple[0] ^ triple[1] ^ triple[2]) : [];
---
<figure class="grid gap-2">
  <figcaption class="note"><strong class="text-ink" set:html={tex(title)} /> <span set:html={tex(note)} /></figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="fig block h-auto w-full max-w-[17rem]" role="img" aria-label={`${title}: 24 点の住所`}>
    {Array.from({ length: 12 }, (_, t) => <text x={56 + t * cell + cell / 2} y="12" text-anchor="middle" font-size="9" fill="rgb(var(--muted))">{12 - t}</text>)}
    {points.map((p, i) => {
      const hl = triple.includes(p), y = 18 + i * cell;
      return <g>
        <title>{`点 ${i + 1}: ${bits(p).join('')}${hl ? '（一直線の 3 点の 1 つ）' : ''}`}</title>
        <text x="48" y={y + 12} text-anchor="end" font-size="9" fill={hl ? 'rgb(var(--heat-pos))' : 'rgb(var(--muted))'}>{i + 1}</text>
        {bits(p).map((b, t) => <rect x={56 + t * cell + 1} y={y + 1} width={cell - 2} height={cell - 2} rx="2" fill={b ? (hl ? 'rgb(var(--heat-pos))' : 'rgb(var(--ink))') : 'rgb(var(--heat-mid))'} />)}
      </g>;
    })}
    {triple.length > 0 && <g>
      <text x="48" y={18 + (points.length + 1) * cell + 12} text-anchor="end" font-size="9" fill="rgb(var(--heat-pos))">和</text>
      {sumRow.map((b, t) => <rect x={56 + t * cell + 1} y={18 + (points.length + 1) * cell + 1} width={cell - 2} height={cell - 2} rx="2" fill={b ? 'rgb(var(--ink))' : 'none'} stroke="rgb(var(--heat-pos))" stroke-width="1.5" />)}
    </g>}
  </svg>
</figure>
