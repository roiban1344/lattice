---
// 「本数 ÷ 群の位数」の見積もり（白抜き）と、実際に数えた軌道の数（塗り）。対数目盛。0 は左端の矢印。
import { tex } from '../lib/tex';
import { num } from '../lib/num';
import { pow10 } from '../lib/svg';
interface Row { name: string; est: number; act: number }
interface Props { rows: Row[] }
const { rows } = Astro.props;
const W = 720, rowH = 46, T = 34, L = 270, R = 24, H = T + rows.length * rowH + 30, e0 = -1, e1 = 7;
const X = (v: number) => L + ((Math.log10(v) - e0) / (e1 - e0)) * (W - L - R);
const fmt = (v: number) => (v < 10 ? v.toFixed(2) : num(Math.round(v)).replace(/\\,/g, '\u2009'));
const ticks = Array.from({ length: e1 - e0 + 1 }, (_, i) => e0 + i);
---
<div class="overflow-x-auto">
<svg viewBox={`0 0 ${W} ${H}`} class="fig block h-auto w-full min-w-[36rem]" role="img" aria-label="見積もりと実際の軌道の数">
  {ticks.map((e) => <g><line x1={X(10 ** e)} x2={X(10 ** e)} y1={T - 8} y2={H - 26} stroke="rgb(var(--rule))" /><text x={X(10 ** e)} y={H - 8} text-anchor="middle" font-size="12" fill="rgb(var(--muted))" set:html={pow10(e)} /></g>)}
  <g font-size="12" fill="rgb(var(--muted))">
    <circle cx={L} cy="12" r="7" fill="none" stroke="rgb(var(--muted))" stroke-width="2" /><text x={L + 12} y="16">見積もり（本数 ÷ 群の位数）</text>
    <circle cx={L + 220} cy="12" r="5" fill="rgb(var(--accent))" /><text x={L + 230} y="16">実際の軌道の数</text>
  </g>
  {rows.map((r, k) => {
    const y = T + k * rowH + rowH / 2, xe = X(r.est), xa = r.act > 0 ? X(r.act) : L;
    return <g>
      <foreignObject x="0" y={y - 11} width={L - 14} height="24"><div xmlns="http://www.w3.org/1999/xhtml" class="fo" style="text-align:right" set:html={tex(r.name)} /></foreignObject>
      <line x1={Math.min(xe, xa)} x2={Math.max(xe, xa)} y1={y} y2={y} stroke="rgb(var(--rule))" stroke-width="2" />
      {r.act > 0
        ? <circle cx={xa} cy={y} r="5" fill="rgb(var(--accent))"><title>{`実際 ${fmt(r.act)}`}</title></circle>
        : <g><path d={`M ${L + 10} ${y - 6} L ${L} ${y} L ${L + 10} ${y + 6}`} fill="none" stroke="rgb(var(--accent))" stroke-width="2" /><text x={L + 14} y={y - 9} font-size="12" fill="rgb(var(--accent))">0</text></g>}
      <circle cx={xe} cy={y} r="9" fill="none" stroke="rgb(var(--muted))" stroke-width="2"><title>{`見積もり ${fmt(r.est)}`}</title></circle>
    </g>;
  })}
</svg>
</div>
