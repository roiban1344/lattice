---
// 候補を段ごとに減らしていく様子。棒の長さは log(1 + 個数)。
import { tex } from '../lib/tex';
import { num } from '../lib/num';
interface Props { steps: { label: string; count: number }[] }
const { steps } = Astro.props;
const max = Math.log10(1 + Math.max(...steps.map((s) => s.count)));
---
<ol class="grid gap-2">
  {steps.map((s) => (
    <li class="grid grid-cols-[minmax(0,1fr)_minmax(0,16rem)] items-center gap-3 sm:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
      <span class="text-[.875rem]" set:html={tex(s.label)} />
      <span class="flex items-center gap-2">
        <span class="h-3 rounded-sm bg-accent" style={`width:${Math.max(0.5, (Math.log10(1 + s.count) / max) * 100)}%`}></span>
        <span class="whitespace-nowrap text-[.9375rem]" set:html={tex(`$${num(s.count)}$`)} />
      </span>
    </li>
  ))}
</ol>
