---
// Siegel 平均 S(n) の対数グラフ。生成時に有理数から計算する。点に触れると値（SVG の title）。
import { bernoulli, siegelMean } from '../lib/lattice';
import { pow10 } from '../lib/svg';
interface Props { refs: { value: number; label: string }[]; highlight: number; knownUpTo: number }
const { refs, highlight, knownUpTo } = Astro.props;
const B = bernoulli(82);
const pts = [] as { n: number; S: number }[];
for (let n = 24; n <= 160; n += 8) pts.push({ n, S: siegelMean(n, B) });
const marks = pts.map((p) => ({ ...p, hl: p.n === highlight, known: p.n <= knownUpTo }));
const W = 720, H = 330, L = 64, R = 16, T = 18, Bm = 40, y0 = -2, y1 = 14;
const X = (n: number) => L + ((n - 24) / (160 - 24)) * (W - L - R);
const Y = (v: number) => T + ((y1 - Math.log10(v)) / (y1 - y0)) * (H - T - Bm);
const sup = (e: number) => String(e).replace(/-/g, '⁻').replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d]);
const sci = (v: number) => { const e = Math.floor(Math.log10(v)); return v >= 1e5 || v < 0.01 ? `${(v / 10 ** e).toFixed(2)}×10${sup(e)}` : v >= 100 ? Math.round(v).toLocaleString('en-US').replace(/,/g, '\u2009') : v.toFixed(2); };
const ticks = Array.from({ length: (y1 - y0) / 2 + 1 }, (_, i) => y0 + 2 * i);
---
<div class="overflow-x-auto">
<svg viewBox={`0 0 ${W} ${H}`} class="fig block h-auto w-full min-w-[30rem]" role="img" aria-label="次元ごとの Siegel 平均（対数目盛）">
  {ticks.map((e) => <g><line x1={L} x2={W - R} y1={Y(10 ** e)} y2={Y(10 ** e)} stroke="rgb(var(--rule))" /><text x={L - 8} y={Y(10 ** e) + 4} text-anchor="end" font-size="12" fill="rgb(var(--muted))" set:html={pow10(e)} /></g>)}
  {[24, 48, 72, 96, 120, 144].map((n) => <text x={X(n)} y={H - Bm + 18} text-anchor="middle" font-size="12" fill="rgb(var(--muted))">{n}</text>)}
  <text x={(L + W - R) / 2} y={H - 4} text-anchor="middle" font-size="12" fill="rgb(var(--muted))">次元 n</text>
  {refs.map((r) => <g><line x1={L} x2={W - R} y1={Y(r.value)} y2={Y(r.value)} stroke="rgb(var(--ink))" stroke-width="1.5" stroke-dasharray="5 4" /><text x={L + 6} y={Y(r.value) - 6} font-size="12" fill="rgb(var(--ink))">{r.label}</text></g>)}
  {marks.map(({ hl, known, ...p }) => (
    <g>
      <circle cx={X(p.n)} cy={Y(p.S)} r={hl ? 7 : 5} fill={hl ? 'rgb(var(--accent))' : known ? 'rgb(var(--ink))' : 'rgb(var(--sheet))'} stroke={hl ? 'rgb(var(--accent))' : 'rgb(var(--ink))'} stroke-width="2" />
      <circle cx={X(p.n)} cy={Y(p.S)} r="14" fill="transparent"><title>{`n = ${p.n}: S(n) ≈ ${sci(p.S)}`}</title></circle>
      {hl && <text x={X(p.n) + 10} y={Y(p.S) + 18} font-size="12" fill="rgb(var(--accent))">{p.n} 次元: {sci(p.S)}</text>}
    </g>
  ))}
  <g font-size="12" fill="rgb(var(--muted))">
    <circle cx={W - 250} cy={T + 4} r="5" fill="rgb(var(--ink))" stroke="rgb(var(--ink))" stroke-width="2" /><text x={W - 240} y={T + 8}>極値格子が既知</text>
    <circle cx={W - 140} cy={T + 4} r="5" fill="rgb(var(--sheet))" stroke="rgb(var(--ink))" stroke-width="2" /><text x={W - 130} y={T + 8}>未知</text>
  </g>
</svg>
</div>
