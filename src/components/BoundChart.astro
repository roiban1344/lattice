---
// テンソル階数 s ごとの Coulangeon の下界（白抜き）と、整数に切り上げた評価（塗り）。破線が目標。
import { tex } from '../lib/tex';
interface Row { s: number; bound: number; hmin: number }
interface Props { rows: Row[]; target: number; hmax?: number }
const { rows, target, hmax = 7 } = Astro.props;
const W = 760, rowH = 46, T = 40, L = 90, R = 190, H = T + rows.length * rowH + 34;
const X = (h: number) => L + (h / hmax) * (W - L - R);
---
<div class="overflow-x-auto">
<svg viewBox={`0 0 ${W} ${H}`} class="fig block h-auto w-full min-w-[30rem]" role="img" aria-label="テンソル階数ごとの Coulangeon の下界">
  {Array.from({ length: hmax + 1 }, (_, h) => <g><line x1={X(h)} x2={X(h)} y1={T - 6} y2={H - 28} stroke="rgb(var(--rule))" /><text x={X(h)} y={H - 10} text-anchor="middle" font-size="12" fill="rgb(var(--muted))">{h}</text></g>)}
  <line x1={X(target)} x2={X(target)} y1={T - 14} y2={H - 28} stroke="rgb(var(--ink))" stroke-width="1.5" stroke-dasharray="5 4" />
  <foreignObject x={X(target) + 6} y={T - 30} width="160" height="22"><div xmlns="http://www.w3.org/1999/xhtml" class="fo" set:html={tex(`目標 $h=${target}$`)} /></foreignObject>
  {rows.map((r, k) => {
    const y = T + k * rowH + rowH / 2, short = r.hmin < target;
    return <g>
      <foreignObject x="0" y={y - 11} width={L - 14} height="24"><div xmlns="http://www.w3.org/1999/xhtml" class="fo" style="text-align:right" set:html={tex(`$s=${r.s}$`)} /></foreignObject>
      <line x1={X(0)} x2={X(r.hmin)} y1={y} y2={y} stroke={short ? 'rgb(var(--warn))' : 'rgb(var(--accent))'} stroke-width="4" stroke-linecap="round" />
      <circle cx={X(r.bound)} cy={y} r="7" fill="rgb(var(--sheet))" stroke="rgb(var(--muted))" stroke-width="2"><title>{`下界 ${r.bound.toFixed(3)}`}</title></circle>
      <circle cx={X(r.hmin)} cy={y} r="5" fill={short ? 'rgb(var(--warn))' : 'rgb(var(--accent))'}><title>{`整数なので h ≥ ${r.hmin}`}</title></circle>
      <foreignObject x={X(Math.max(r.hmin, r.bound)) + 14} y={y - 11} width="220" height="24"><div xmlns="http://www.w3.org/1999/xhtml" class="fo" style="color:rgb(var(--muted))" set:html={tex(String.raw`$${r.bound.toFixed(2)}\ \Rightarrow\ h\ge${r.hmin}$` + (short ? '（$1$ 段不足）' : ''))} /></foreignObject>
    </g>;
  })}
</svg>
</div>
