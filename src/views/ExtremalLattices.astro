---
// 頁 1「極値格子とは」の中身。本文は sections/extremal-lattices/<lang>/ の Markdown（節ごとに 1 ファイル、題は frontmatter）。
// 図と表はここで生成時に計算して、決まった節の後ろに差し込む。
import Page from '../layouts/Page.astro';
import Sec from '../components/Sec.astro';
import Heatmap from '../components/Heatmap.astro';
import Refs from '../components/Refs.astro';
import { E8 } from '../lib/e8';
import { bareiss, extremalTheta } from '../lib/lattice';
import { tex } from '../lib/tex';
import { n$ } from '../lib/num';
import { UI, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

type Md = { frontmatter: { title: string }; Content: any };
const all = import.meta.glob<Md>('../sections/extremal-lattices/*/*.md', { eager: true });
const parts = Object.entries(all)
  .filter(([p]) => p.includes(`/${lang}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([p, m]) => ({ id: p.split('/').pop()!.replace(/^\d+-|\.md$/g, ''), title: m.frontmatter.title, Content: m.Content }));
const sections = [...parts.map(({ id, title }) => ({ id, title })), { id: 'references', title: { en: 'References', ja: '文献' }[lang] }];

if (bareiss(E8).det !== 1n) throw new Error('E8: det != 1');

// 次元 8, 16, …, 120 の極値テータ級数から、上界と最小ノルムのベクトルの本数。
const rows = Array.from({ length: 15 }, (_, i) => 8 * (i + 1)).map((n) => {
  const m = Math.floor(n / 24) + 1, th = extremalTheta(n, m + 1);
  return { n, min: th.min, kiss: th.coefficients[m] as bigint };
});

const t = {
  e8: { en: 'Gram matrix of E₈ (8×8)', ja: 'E₈ の Gram 行列（8×8）' }[lang],
  e8cap: {
    en: String.raw`Positive entries are red, negative entries blue, zeros grey. The diagonal entries are $2$, and $\det G=1$ (computed when the page is built).`,
    ja: String.raw`正の成分は赤、負の成分は青、$0$ は灰色で示しています。対角成分はすべて $2$ で、$\det G=1$ です（頁の生成時に計算）。`,
  }[lang],
  head: { en: [String.raw`dimension $n$`, String.raw`bound $2\lfloor n/24\rfloor+2$`, 'vectors of minimal norm'], ja: [String.raw`次元 $n$`, String.raw`上界 $2\lfloor n/24\rfloor+2$`, '最小ノルムのベクトルの本数'] }[lang].map(tex),
  cap: {
    en: 'Numbers of vectors of minimal norm in an extremal lattice, read off from the unique modular form described above. They are computed in exact rational arithmetic when the page is built. The table says nothing about whether such a lattice exists.',
    ja: '極値格子の最小ノルムのベクトルの本数です。上で述べた、ただ一つに決まるモジュラー形式の係数から読み取れます。頁の生成時に有理数で厳密に計算しています。この表は、そのような格子が存在するかどうかについては何も述べていません。',
  }[lang],
};
const refKeys = ['Ser73', 'Nie73', 'Sie69', 'MOS75', 'JR11', 'Via17', 'CKMRV17', 'BV01'];
---
<Page lang={lang} slug="extremal-lattices" sections={sections}>
  <header class="grid gap-4">
    <h1 class="text-[2.25rem] font-bold">{{ en: 'Extremal lattices', ja: '極値格子とは' }[lang]}</h1>
    {parts.length === 0 && <p class="note">{UI.draft[lang]}</p>}
  </header>
  {parts.map(({ id, title, Content }) => (
    <Sec s={{ id, title }}>
      <div class="prose-lat"><Content /></div>
      {id === 'lattices' && <div class="max-w-[22rem]"><Heatmap src="data/e8.json" lang={lang} label={t.e8} caption={tex(t.e8cap)} /></div>}
      {id === 'bound' && (
        <figure class="grid gap-2">
          <div class="overflow-x-auto">
            <table class="tbl max-w-prose">
              <thead><tr>{t.head.map((h, i) => <th class={i ? 'num' : ''} set:html={h} />)}</tr></thead>
              <tbody>{rows.map((r) => <tr><td set:html={tex(n$(r.n))} /><td class="num" set:html={tex(n$(r.min))} /><td class="num" set:html={tex(n$(r.kiss))} /></tr>)}</tbody>
            </table>
          </div>
          <figcaption class="note max-w-prose">{t.cap}</figcaption>
        </figure>
      )}
    </Sec>
  ))}
  <Sec s={sections.at(-1)!}><Refs keys={refKeys} /></Sec>
</Page>
